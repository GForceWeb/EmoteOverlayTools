# Vite environment variables
VITE_APP_TITLE="G-Force's Emote Tools"
VITE_DEFAULT_MAX_EMOTES=200
VITE_DEFAULT_SERVER=localhost:8080
# Register a Twitch Developer application with Client Type: Public.
# Device code login needs only the Client ID, no secret or redirect URI.
# This public ID is bundled into the Electron main process at build time.
TWITCH_CLIENT_ID=""
GH_TOKEN="your_github_token_here"
